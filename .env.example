# Copy to `.env` locally. Never commit `.env`.
# VOW will not overwrite an existing `.env` file.

# Meterless Nightshift Runtime (OpenAI-compatible)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
METERLESS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_TIMEOUT_MS=60000
METERLESS_INPUT_COST_PER_1K=0
METERLESS_OUTPUT_COST_PER_1K=0

# Local workspace and JSON persistence
VOW_WORKSPACE_DIR=./data/workspace
VOW_DATA_DIR=./data

# Background-worker HTTP trigger (POST /api/worker/tick).
# Empty = local/dev default with per-minute rate limiting.
# Set a token to require `Authorization: Bearer <token>` on tick requests.
# The enqueue route drives the worker in-process, so a token never breaks Away Mode.
VOW_WORKER_TOKEN=
VOW_WORKER_TICK_PER_MINUTE=20

# Zetaris REST (read-only SQL through Warden)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_TIMEOUT_MS=15000
